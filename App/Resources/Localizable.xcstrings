    "%@ of %@ entries · the helper keeps the last 300": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 %@ 条，共 %@ 条 · 辅助服务保留最近 300 条"
