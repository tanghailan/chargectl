        }
      }
    },
    "Stop anywhere from 20% to 100%.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 20% 至 100% 之间设置停止充电的电量。"
          }
        }
      }
    },
    "Stops what Chargectl is doing and goes back to the limit.": {
      "localizations": {
        "zh-Hans": {
