    "Starts %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 开始"
          }
        }
      }
    },
    "Starts Chargectl when you log in. The helper keeps your limit either way.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动 Chargectl。无论是否开启此选项，辅助程序都会维持充电上限。"
          }
        }
      }
    },
    "Starts about %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@ 开始"
          }
        }
      }
    },
    "Starts by itself once it’s installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后自动启动。"
          }
        }
      }
    },
    "Starts just long enough before, so the battery isn’t kept full for hours, then goes back to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提前足够的时间开始充电，避免电池长时间保持满电，然后恢复至 %@。"
          }
        }
      }
    },
    "Steady": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定"
          }
        }
      }
    },
