          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic lets the light show charging as usual: amber while charging, green when held.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式下指示灯照常显示充电状态：充电时为琥珀色，保持电量时为绿色。"
          }
        }
      }
    },
    "Automatic updates off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新已关闭"
          }
        }
      }
    },
    "Automatic updates on": {
      "localizations": {
        "zh-Hans": {
