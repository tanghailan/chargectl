        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达设定时间"
          }
        }
      }
    },
    "Auto discharge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动放电"
          }
        }
      }
