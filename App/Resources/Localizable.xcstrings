      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %lld percent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，百分之 %lld"
          }
        }
      }
    },
    "%@ at %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失败。"
          }
        }
      }
    },
    "%@ finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已完成"
          }
        }
      }
    },
    "%@ h": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 小时"
          }
        }
      }
    },
    "%@ is also running. Quit it so the two don't fight.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也正在运行。请退出该应用以避免冲突。"
          }
        }
      }
    },
    "%@ macOS charges to 100%% and the settings below are paused.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS 将充电至 100%%，下方设置暂时停用。"
          }
        }
      }
    },
    "%@ of it resting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %@ 处于休息状态"
          }
        }
      }
    },
    "%@ only, %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅%@，%@"
          }
        }
      }
    },
    "%@ skipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过 %@ 条"
