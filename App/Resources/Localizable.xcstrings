{
  "sourceLanguage": "en",
  "strings": {
    " Charging pauses above %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 温度高于 %@ 时暂停充电。"
          }
        }
      }
    },
    " If the charge drifts down, it is not topped up until it reaches %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 如果电量下降，直到降至 %@ 才会重新充电。"
          }
        }
      }
    },
    " Plugged in above the limit, the Mac runs on the charger and the battery stays where it is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 接通电源时，如果电量高于限制，Mac 使用电源适配器运行，电池电量保持不变。"
          }
        }
      }
    },
    " Plugged in above the limit, the battery discharges down to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 接通电源时，如果电量高于限制，电池会放电至 %@。"
          }
        }
      }
    },
    "%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%"
          }
        }
      }
    },
    "%+.1f since %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自 %2$@ 起变化 %1$+.1f"
          }
        }
      }
    },
    "%.1f a month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %.1f"
          }
        }
      }
    },
    "%.1f h": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f 小时"
          }
        }
      }
    },
    "%1$@ before, from %2$@%%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前 %1$@，从 %2$@%% 开始"
          }
        }
      }
    },
    "%1$@ of %2$@ entries · the helper keeps the last 300": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %2$@ 条，显示 %1$@ 条 · 辅助程序保留最近 300 条"
          }
        }
      }
    },
    "%1$@%2$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%1$@%2$@%3$@%4$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@%3$@%4$@"
          }
        }
      }
    },
    "%1$@–%2$@%3$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@%3$@"
          }
        }
      }
    },
