    "The battery is already at or below %lld%%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量已达到或低于 %lld%%"
          }
        }
      }
    },
    "The battery is at %@ now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前电量为 %@。"
          }
        }
      }
    },
    "The battery is warm. Charging resumes when it cools down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度较高。冷却后将继续充电。"
          }
        }
      }
    },
    "The battery runs the Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池正在为 Mac 供电"
          }
        }
      }
    },
    "The battery’s charge in percent, and what Chargectl is doing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取电池电量百分比和 Chargectl 当前的操作。"
          }
        }
      }
    },
    "The charge beside the ring, as in %@.": {
